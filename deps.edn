{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;; This actor is a coordination-layer actor over pure domain data
 ;; (consist/cargo-manifest/routing/maintenance records) -- it does not
 ;; wrap a bespoke capability library the way `cloud-itonami-isic-4920`
 ;; wraps `kotoba-lang/logistics`, because none of this actor's four ops
 ;; (`:log-shipment-record`/`:schedule-service-operation`/`:flag-track-
 ;; safety-concern`/`:coordinate-maintenance`) touch a validated external
 ;; format the way a parcel tracking number does; see README `Scope`.
 ;; This repo is standalone (forkable outside the workspace); the
 ;; :local/root paths only resolve inside the monorepo checkout -- a
 ;; standalone fork should override them with git coordinates.
 :deps {;; jp-go-dds -- this workspace's base design system (デジタル庁
        ;; デザインシステム). Used ONLY by `railfreight.render-html` to skin
        ;; the build-time operator console; the actor itself has no UI.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "railfreight.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the real actor stack
  ;; (flagship checklist item 2). Refuses to write if the run produced
  ;; no governor hold -- see railfreight.render-html/-main.
  :render-html {:main-opts ["-m" "railfreight.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
